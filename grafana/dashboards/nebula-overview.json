{
  "uid": "nebula-overview",
  "title": "Nebula / Overview (Q1–Q5)",
  "description": "클러스터 건강 → 서비스 에러 → 지연 → 리소스 → 시스템 개요 순서로 '어디부터 볼지'를 안내하는 첫 화면",
  "tags": [
    "nebula",
    "overview"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "amp",
        "label": "Metrics (AMP)",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "refresh": 1,
        "current": {},
        "options": [],
        "regex": ""
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${amp}"
        },
        "definition": "label_values(up{job=\"otelcol\"}, cluster)",
        "query": {
          "query": "label_values(up{job=\"otelcol\"}, cluster)",
          "refId": "var-cluster"
        },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "current": {},
        "options": [],
        "regex": ""
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Nebula dashboards",
      "type": "dashboards",
      "tags": [
        "nebula"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Runbook",
      "url": "https://github.com/shashax42/Nebula-Monitoring/blob/main/docs/RUNBOOK.md",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Q1. 클러스터 건강 상태",
      "collapsed": false,
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
