{
  "uid": "nebula-tenant",
  "title": "Nebula / Tenants (Multi-tenancy)",
  "description": "tenant_id 단위 트래픽·에러·지연, 티어별 SLA, Noisy Neighbor 판별, 테넌트 비용 배분/효율",
  "tags": [
    "nebula",
    "tenant"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "amp",
        "label": "Metrics (AMP)",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "refresh": 1,
        "current": {},
        "options": [],
        "regex": ""
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${amp}"
        },
        "definition": "label_values(up{job=\"otelcol\"}, cluster)",
        "query": {
          "query": "label_values(up{job=\"otelcol\"}, cluster)",
          "refId": "var-cluster"
        },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "current": {},
        "options": [],
        "regex": ""
      },
      {
        "name": "cloudwatch",
        "label": "CloudWatch",
        "type": "datasource",
        "query": "cloudwatch",
        "hide": 0,
        "refresh": 1,
        "current": {},
        "options": [],
        "regex": ""
      },
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${amp}"
        },
        "definition": "label_values(tenant:requests:rate5m{cluster=\"$cluster\"}, tenant_id)",
        "query": {
          "query": "label_values(tenant:requests:rate5m{cluster=\"$cluster\"}, tenant_id)",
          "refId": "var-tenant"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "hide": 0,
        "current": {},
        "options": [],
        "regex": "",
        "allValue": ".*"
      },
      {
        "name": "aurora",
        "label": "Aurora cluster",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "${cloudwatch}"
        },
        "hide": 0,
        "refresh": 1,
        "query": {
          "queryType": "DimensionValues",
          "region": "default",
          "namespace": "AWS/RDS",
          "metricName": "CPUUtilization",
          "dimensionKey": "DBClusterIdentifier",
          "refId": "var-aurora"
        },
        "current": {},
        "options": [],
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Nebula dashboards",
      "type": "dashboards",
      "tags": [
        "nebula"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Runbook",
      "url": "https://github.com/shashax42/Nebula-Monitoring/blob/main/docs/RUNBOOK.md",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "테넌트 Golden Signals",
      "collapsed": false,
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Traffic by tenant_id (req/s)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${amp}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${amp}"
          },
          "expr": "topk(10, tenant:requests:rate5m{cluster=\"$cluster\",tenant_id=~\"$tenant\"})",
          "legendFormat": "{{tenant_id}} ({{tenant_tier}})",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "gradientMode": "none"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "에러율 by tenant_id",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${amp}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${amp}"
          },
          "expr": "tenant:error_ratio:rate5m{cluster=\"$cluster\",tenant_id=~\"$tenant\"} > 0",
          "legendFormat": "{{tenant_id}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "gradientMode": "none",
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "axisSoftMax": 0.0015
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.001
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      }
    },
    {
