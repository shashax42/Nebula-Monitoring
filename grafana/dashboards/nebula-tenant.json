        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${amp}"
          },
          "expr": "topk(10, tenant:latency_seconds:p99_5m{cluster=\"$cluster\",tenant_id=~\"$tenant\"})",
          "legendFormat": "{{tenant_id}}",
          "range": true,
