      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${amp}"
          },
          "expr": "sort_desc(tenant:error_budget_burn:rate1h{cluster=\"$cluster\",tenant_id=~\"$tenant\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "x",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "links": [
            {
              "title": "Runbook: Enterprise SLA",
              "url": "https://github.com/shashax42/Nebula-Monitoring/blob/main/docs/RUNBOOK.md#tenantenterprisesloburn",
              "targetBlank": true
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "#EAB839",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 6
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "번레이트",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "collector": true,
              "environment": true,
              "cluster": true,
              "otel_scope_name": true,
              "otel_scope_version": true,
              "otel_scope_schema_url": true
            },
            "renameByName": {
              "Value": "번레이트",
              "tenant_id": "테넌트",
              "tenant_tier": "티어"
            }
          }
        }
