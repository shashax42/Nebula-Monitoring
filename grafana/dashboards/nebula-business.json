        "type": "prometheus",
        "uid": "${amp}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${amp}"
          },
          "expr": "saga_topic:producer_latency_seconds:p95_5m{cluster=\"$cluster\"}",
