    {
      "type": "row",
      "title": "결제 — 실패 원인 분리 (카드 한도 초과 vs PG 타임아웃)",
      "collapsed": false,
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "실패 원인별 결제 실패 (건/s)",
      "description": "gateway 가 PG 응답코드를 카테고리로 정규화. 주황/빨강 = 시스템 원인(우리가 대응), 청록/파랑 = 고객·카드사 원인",
      "datasource": {
        "type": "prometheus",
        "uid": "${amp}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${amp}"
          },
          "expr": "sum by (payment_failure_category) (payment:failures_by_category:rate5m{cluster=\"$cluster\"})",
          "legendFormat": "{{payment_failure_category}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: 건/s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "gradientMode": "none",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "pg_timeout"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "pg_unavailable"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "other"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#C4A000"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "card_limit_exceeded"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#1F78C1"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "insufficient_funds"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5794F2"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "card_declined"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2C7BB6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "invalid_card"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8AB8FF"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "fraud_suspected"
            },
            "properties": [
              {
                "id": "color",
