{
  "uid": "nebula-business",
  "title": "Nebula / Order Saga & Messaging",
  "description": "주문 사가 단계별 흐름·완료율, 발행 실패, 보상(취소) 누락, 재고 거절, Kafka 구간 지연·적체, 배치 실행 결과",
  "tags": [
    "nebula",
    "business",
    "saga"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "amp",
        "label": "Metrics (AMP)",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "refresh": 1,
        "current": {},
        "options": [],
        "regex": ""
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${amp}"
        },
        "definition": "label_values(up{job=\"otelcol\"}, cluster)",
        "query": {
          "query": "label_values(up{job=\"otelcol\"}, cluster)",
          "refId": "var-cluster"
        },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "current": {},
        "options": [],
        "regex": ""
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Nebula dashboards",
      "type": "dashboards",
      "tags": [
        "nebula"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Runbook",
      "url": "https://github.com/shashax42/Nebula-Monitoring/blob/main/docs/RUNBOOK.md",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "주문 사가 — HTTP 지표로는 안 보이는 흐름 단절",
      "collapsed": false,
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "bargauge",
      "title": "단계별 이벤트 (최근 1시간)",
      "description": "거절·취소는 3단계의 부분집합. 거절 수와 취소 수가 다르면 보상 누락",
      "datasource": {
        "type": "prometheus",
        "uid": "${amp}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${amp}"
          },
          "expr": "sum(saga:events:increase1h{cluster=\"$cluster\",funnel_stage=\"order_placed\"}) or vector(0)",
          "legendFormat": "1 주문 접수 (order)",
          "range": false,
          "instant": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${amp}"
          },
          "expr": "sum(saga:events:increase1h{cluster=\"$cluster\",funnel_stage=\"purchase_published\"}) or vector(0)",
          "legendFormat": "2 purchase 발행 (order)",
          "range": false,
          "instant": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${amp}"
          },
          "expr": "sum(saga:events:increase1h{cluster=\"$cluster\",funnel_stage=\"purchase_consumed\"}) or vector(0)",
          "legendFormat": "3 재고 처리 (product)",
          "range": false,
          "instant": true
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${amp}"
          },
          "expr": "sum(saga:events:increase1h{cluster=\"$cluster\",funnel_stage=\"stock_rejected\"}) or vector(0)",
          "legendFormat": "└ 재고 부족 거절 (product)",
          "range": false,
          "instant": true
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "${amp}"
          },
          "expr": "sum(saga:events:increase1h{cluster=\"$cluster\",funnel_stage=\"order_canceled\"}) or vector(0)",
          "legendFormat": "└ 보상: 주문 취소 (order)",
          "range": false,
          "instant": true
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "${amp}"
          },
          "expr": "sum(saga:events:increase1h{cluster=\"$cluster\",funnel_stage=\"purchase_publish_failed\"}) or vector(0)",
          "legendFormat": "✕ 발행 실패 (order)",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "text"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 10,
        "h": 9
      }
    },
    {
      "type": "stat",
      "title": "사가 완료율 (1h)",
      "description": "재고 차감까지 끝난 주문 / 접수된 주문. 재고 부족 거절도 완료율을 낮춘다",
      "datasource": {
        "type": "prometheus",
        "uid": "${amp}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${amp}"
          },
          "expr": "saga:completion:ratio1h{cluster=\"$cluster\"}",
          "legendFormat": "__auto",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.97
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "—",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 3,
      "gridPos": {
        "x": 10,
        "y": 1,
        "w": 7,
        "h": 9
      }
    },
    {
      "type": "stat",
      "title": "발행 실패율 (5m)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${amp}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${amp}"
          },
          "expr": "saga:publish_failure:ratio_rate5m{cluster=\"$cluster\"}",
          "legendFormat": "__auto",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 0.001
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "—",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "links": [
        {
          "title": "Runbook: 발행 실패",
          "url": "https://github.com/shashax42/Nebula-Monitoring/blob/main/docs/RUNBOOK.md#sagapublishfailures",
          "targetBlank": true
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 17,
        "y": 1,
        "w": 7,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "단계별 처리량 (건/s)",
      "description": "order_placed ≈ purchase_published ≈ purchase_consumed 가 정상. 아래로 벌어지는 선이 끊긴 구간",
      "datasource": {
        "type": "prometheus",
        "uid": "${amp}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${amp}"
          },
          "expr": "sum by (funnel_stage) (saga:events:rate5m{cluster=\"$cluster\"})",
          "legendFormat": "{{funnel_stage}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: 건/s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "gradientMode": "none"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "단계 사이에 멈춘 건수 (15분 창)",
      "description": "창 경계의 처리 중 이벤트 때문에 작은 값은 정상. 보상 누락이 쌓이면 SagaCompensationGap",
      "datasource": {
        "type": "prometheus",
        "uid": "${amp}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${amp}"
          },
          "expr": "saga:consume_gap:increase15m{cluster=\"$cluster\"}",
          "legendFormat": "발행 - 재고 처리",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${amp}"
          },
          "expr": "saga:compensation_gap:increase15m{cluster=\"$cluster\"}",
          "legendFormat": "재고 거절 - 주문 취소 (보상 누락)",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "gradientMode": "none"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "links": [
        {
          "title": "Runbook: 보상 누락",
          "url": "https://github.com/shashax42/Nebula-Monitoring/blob/main/docs/RUNBOOK.md#sagacompensationgap",
          "targetBlank": true
        },
        {
          "title": "Runbook: 사가 정지",
          "url": "https://github.com/shashax42/Nebula-Monitoring/blob/main/docs/RUNBOOK.md#sagastalled",
          "targetBlank": true
        }
      ],
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "재고 부족 거절률",
      "description": "시스템 장애가 아니라 품절/프로모션 신호. SLO 와 분리해서 본다",
      "datasource": {
        "type": "prometheus",
        "uid": "${amp}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${amp}"
          },
          "expr": "saga:stock_rejection:ratio_rate15m{cluster=\"$cluster\"}",
          "legendFormat": "15m",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${amp}"
          },
          "expr": "2 * avg_over_time(saga:stock_rejection:ratio_rate15m{cluster=\"$cluster\"}[1d])",
          "legendFormat": "알림 기준 (1일 평균 × 2)",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "gradientMode": "none"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "links": [
        {
          "title": "Runbook: 재고 거절 급증",
          "url": "https://github.com/shashax42/Nebula-Monitoring/blob/main/docs/RUNBOOK.md#stockrejectionspike",
          "targetBlank": true
        }
      ],
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "취소·실패 사유 (5m, 건/s)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${amp}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${amp}"
          },
          "expr": "sort_desc(sum by (funnel_stage, reason) (saga:events:rate5m{cluster=\"$cluster\",reason!=\"none\"}) > 0)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: 건/s",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "건/s",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "collector": true,
              "environment": true,
              "cluster": true,
              "otel_scope_name": true,
              "otel_scope_version": true,
              "otel_scope_schema_url": true
            },
            "renameByName": {
              "Value": "건/s",
              "funnel_stage": "단계",
              "reason": "사유"
            }
          }
        }
      ],
      "id": 8,
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "row",
      "title": "Kafka — 토픽 구간 (purchase: order → product, refund: product → order)",
