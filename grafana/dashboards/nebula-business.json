      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${amp}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${amp}"
          },
          "expr": "messaging:kafka_consumer_lag:sum{cluster=\"$cluster\"}",
          "legendFormat": "{{group}} / {{topic}}",
          "range": true,
