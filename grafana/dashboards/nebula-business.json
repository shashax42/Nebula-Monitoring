    {
      "type": "timeseries",
      "title": "장바구니 점유 비율 (봇 재고 잠식 지표)",
      "description": "결제 없이 장바구니만 점유하는 봇이 늘면 비율이 평소의 2배를 넘는다",
      "datasource": {
        "type": "prometheus",
        "uid": "${amp}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${amp}"
          },
          "expr": "funnel:cart_hoarding:ratio15m{cluster=\"$cluster\"}",
          "legendFormat": "장바구니/결제시작",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${amp}"
          },
          "expr": "2 * avg_over_time(funnel:cart_hoarding:ratio15m{cluster=\"$cluster\"}[1d])",
          "legendFormat": "알림 기준 (1일 평균 × 2)",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "x",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "gradientMode": "none"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "links": [
        {
          "title": "Runbook: 장바구니 점유",
          "url": "https://github.com/shashax42/Nebula-Monitoring/blob/main/docs/RUNBOOK.md#carthoardingsuspected",
          "targetBlank": true
